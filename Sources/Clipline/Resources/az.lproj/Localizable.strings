/* Welcome */
"Show Welcome…" = "Xoş gəlmisiniz ekranını göstər…";
"Welcome to Clipline" = "Clipline-a xoş gəlmisiniz";
"Out of sight, within reach" = "Gözdən uzaq, əl altında";
"Its own screenshot tool" = "Öz ekran şəkli aləti";
"A gesture for everything" = "Hər iş üçün bir jest";
"Snip to clear" = "Kəs və təmizlə";
